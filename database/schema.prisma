// -----------------------------------------------------------------------------
// King World -- Phase 1 relational schema
// -----------------------------------------------------------------------------
// Provider note (IMPORTANT -- read before adding new columns):
//   SQLite is the Phase 1 datasource. The SQLite connector in Prisma does not
//   support native `enum` or `Json` scalars, and has no unsigned integers.
//   Therefore:
//     * enum-like columns are `String` + validated by Zod enums in
//       packages/shared/src/enums.ts (single source of truth),
//     * structured payloads are `String` holding JSON, wrapped by the
//       typed helpers in packages/shared/src/json.ts,
//     * money is `Int` in MINOR UNITS (e.g. cents) -- never a float.
//   Phase 2 migration path to Postgres: swap these to `enum` + `jsonb` +
//   `numeric(19,4)`. See docs/ARCHITECTURE.md ? Database Portability.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// IDENTITY & ACCESS
// =============================================================================

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  displayName  String
  /// OWNER | ADMIN | OBSERVER -- see packages/shared/src/enums.ts UserRole
  role         String  @default("OBSERVER")
  isActive     Boolean @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedCompanies Company[]        @relation("CompanyOwner")
  memberships    CompanyMember[]
  sentMessages   Message[]        @relation("MessageSenderUser")
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  decidedApprovals   ApprovalRequest[] @relation("ApprovalDecider")
  activityLogs   ActivityLog[]
  conversations  Conversation[]
  wallets        Wallet[]

  // Phase 2
  plansCreated         Plan[]        @relation("PlanCreatorUser")
  reportsWritten       Report[]      @relation("ReportAuthorUser")
  reviewsWritten       TaskReview[]  @relation("ReviewAuthorUser")
  escalationsReceived  Escalation[]  @relation("EscalationToUser")

  @@index([role])
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  ownerId     String
  /// Denormalised pointer to the Wallet whose ownerType=COMPANY, ownerId=id.
  /// Resolved exclusively through packages/economy LedgerService so the two
  /// can never disagree.
  treasuryWalletId String?
  foundedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User              @relation("CompanyOwner", fields: [ownerId], references: [id])
  departments Department[]
  members   CompanyMember[]
  projects  Project[]
  tasks     Task[]
  agents    Agent[]
  conversations Conversation[]
  approvals ApprovalRequest[]
  plans     Plan[]

  @@index([ownerId])
}

model Department {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members CompanyMember[]

  @@unique([companyId, name])
  @@index([companyId])
}

model CompanyMember {
  id           String   @id @default(cuid())
  companyId    String
  agentId      String
  departmentId String?
  title        String
  /// Free-form role key, matched against Agent.roleKey. Drives behaviour via
  /// the RoleProfile registry -- never branch on the agent's name.
  roleKey      String
  /// Annual salary in MINOR UNITS. Paid via SALARY transactions.
  salaryMinor  Int      @default(0)
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent      Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?

  @@unique([companyId, agentId])
  @@index([agentId])
  @@index([departmentId])
}

// =============================================================================
// WORLD - CITY - LOCATIONS - SIMULATION CLOCK
// =============================================================================

model World {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  // -- Simulation clock ------------------------------------------------------
  // simulatedNow() = new Date(now + timeOffsetMinutes).
  // A heartbeat advances the offset by (realMinutes x timeScale).
  // Phase 1: Float so development speeds like 0.5x are representable.
  timeScale         Float @default(60)
  // Fractional SIMULATED minutes accumulated by ticks. Float so sub-minute
  // advances (0.5x speed) are not truncated away every tick.
  timeOffsetMinutes Float @default(0)
  lastTickAt        DateTime?

  /// INITIALIZING | RUNNING | PAUSED | STOPPED | ERROR --
  /// see packages/shared/src/enums.ts WorldStatusSchema
  status String @default("INITIALIZING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities    City[]
  agents    Agent[]
  approvals ApprovalRequest[]
}

model City {
  id          String   @id @default(cuid())
  worldId     String
  name        String
  description String?
  /// district / town / capital -- extensible for Phase 2 districts.
  kind        String   @default("CITY")
  population  Int      @default(0)
  foundedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world     World      @relation(fields: [worldId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([worldId, name])
  @@index([worldId])
}

model Location {
  id       String  @id @default(cuid())
  cityId   String
  name     String
  /// HQ | BANK | MARKET | OFFICE | HOME | SHOP | RESTAURANT | SCHOOL |
  /// HOSPITAL | GOVERNMENT | TRANSPORT | PUBLIC_SPACE | OTHER
  kind     String  @default("OTHER")
  address  String?
  capacity Int?
  /// JSON -- Phase 2: geometry, floorplan, opening hours, price modifiers.
  metadata String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city   City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  agents Agent[]
  activities AgentActivity[]

  @@unique([cityId, name])
  @@index([cityId])
  @@index([kind])
}

// =============================================================================
// AGENTS
// =============================================================================

model Agent {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  /// Behaviour key resolved by packages/agents RoleProfileRegistry.
  /// e.g. PLANNER, EXECUTOR.  Adding a role must never require code changes to
  /// any `if (agent.name === ...)` branch -- there are none.
  roleKey  String
  title    String
  /// Profile written by the Agent Factory; seeded for the two Phase 1 agents.
  systemPrompt String
  personality   String @default("{}") // JSON
  goals         String @default("[]") // JSON string[]
  skills        String @default("[]") // JSON string[]
  /// JSON -- declared abilities. Narrowed at runtime by granted permissions.
  capabilities  String @default("[]") // JSON string[]

  // -- Phase 2 orchestration profile ----------------------------------------
  /// JSON -- { provider?, model?, temperature?, maxTokens?, contextWindow? }.
  /// Consumed by ModelRouter; the columns above stay authoritative when absent.
  routingOverrides String @default("{}")
  /// MAX | NORMAL | LOW. Workload governor consulted before delegation.
  concurrency String @default("NORMAL")

  // -- AI provider selection (never hard-coded) ------------------------------
  // providerId is resolved through the AIProvider registry in packages/ai.
  // Changing provider or model is a data change; agent logic is untouched.
  providerId String
  model      String
  temperature Float @default(0.3)
  maxTokens  Int    @default(2048)

  // -- World placement -------------------------------------------------------
  worldId         String?
  currentLocationId String?
  currentCompanyId String?
  currentJob      String?

  /// Aggregate standing, 0-100. Phase 2 derives it from event history.
  reputation Int @default(50)

  isActive Boolean   @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  world         World?    @relation(fields: [worldId], references: [id], onDelete: SetNull)
  currentLocation Location? @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  currentCompany Company?  @relation(fields: [currentCompanyId], references: [id], onDelete: SetNull)

  state         AgentState?
  memories      AgentMemory[]
  stateHistory  AgentStateHistory[]
  activities    AgentActivity[]
  /// Structured Phase 1 goals; the scalar `goals` column above remains the
  /// legacy free-form list and is not read by the simulation.
  structuredGoals AgentGoal[]
  memberships   CompanyMember[]
  sentMessages  Message[]       @relation("MessageSenderAgent")
  createdTasks  Task[]          @relation("TaskCreatorAgent")
  assignedTasks Task[]          @relation("TaskAssigneeAgent")
  conversations ConversationParticipant[]
  toolInvocations ToolInvocation[]
  relationshipsOut AgentRelationship[] @relation("RelationshipSource")
  relationshipsIn  AgentRelationship[] @relation("RelationshipTarget")
  blueprintsRequested AgentBlueprint[] @relation("BlueprintRequester")
  approvalRequests  ApprovalRequest[]   @relation("ApprovalRequestAgentRequester")

  // -- Phase 2 relationships --------------------------------------------------
  sessions           AgentSession[]
  plansCreated       Plan[]           @relation("PlanCreatorAgent")
  reportsWritten     Report[]         @relation("ReportAuthorAgent")
  reviewsWritten     TaskReview[]     @relation("ReviewAuthorAgent")
  escalationsRaised  Escalation[]     @relation("EscalationFromAgent")
  escalationsReceived Escalation[]    @relation("EscalationToAgent")
  asSupervisor       AgentHierarchy[] @relation("HierarchySupervisor")
  asSubordinate      AgentHierarchy[] @relation("HierarchySubordinate")
  workspaces         Workspace[]
  workspaceMemberships WorkspaceMember[]
  artifacts          Artifact[]
  executions         ExecutionJob[]

  @@index([roleKey])
  @@index([worldId])
  @@index([currentCompanyId])
  @@index([currentLocationId])
}

model AgentState {
  id      String @id @default(cuid())
  agentId String @unique

  /// ONLINE | OFFLINE | IDLE | WORKING | THINKING | WAITING | SLEEPING |
  /// ERROR | PAUSED
  state String @default("OFFLINE")
  activity  String?
  mood      String?

  currentTaskId     String?
  currentLocationId String?
  /// JSON -- Phase 2: energy, hunger, social need, focus.
  vitals            String @default("{}")

  lastActivityAt DateTime?
  errorCount     Int       @default(0)
  updatedAt      DateTime  @updatedAt

  agent     Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  currentTask Task? @relation("AgentStateCurrentTask", fields: [currentTaskId], references: [id], onDelete: SetNull)

  @@index([state])
  @@index([currentTaskId])
}

model AgentStateHistory {
  id       String  @id @default(cuid())
  agentId  String
  fromState String?
  toState  String
  activity String?
  reason   String?
  changedAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, changedAt])
}

/// Phase 1 activity system. An activity is what an agent is occupationally
/// DOING over an interval of simulated time (work, rest, sleep, ...). The
/// simulation engine advances these on tick; the decision engine creates them.
model AgentActivity {
  id String @id @default(cuid())
  agentId String

  /// WORK | REST | THINK | TRAVEL | SOCIALIZE | IDLE | SLEEP --
  /// see packages/shared/src/enums.ts ActivityTypeSchema
  type String
  /// PLANNED | ACTIVE | COMPLETED | CANCELLED | FAILED
  status String @default("PLANNED")

  startTime       DateTime  @default(now())
  expectedEndTime DateTime?
  actualEndTime   DateTime?
  locationId String?

  /// JSON -- activity-specific payload (progress notes, source decision id).
  metadata String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([agentId, status])
  @@index([agentId, startTime])
  @@index([locationId])
}

/// Phase 1 goal system. Structured upgrade of the legacy JSON goals column:
/// agents can now track progress and lifecycle per goal. The Agent.goals JSON
/// column stays as the free-form legacy list and is not read by the simulation.
model AgentGoal {
  id String @id @default(cuid())
  agentId String
  title String
  description String?

  /// LOW | MEDIUM | HIGH | CRITICAL
  priority String @default("MEDIUM")
  /// PENDING | ACTIVE | PAUSED | COMPLETED | FAILED | CANCELLED
  status String @default("PENDING")
  /// 0-100
  progress Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
}

model AgentMemory {
  id      String @id @default(cuid())
  agentId String

  /// SHORT_TERM | LONG_TERM | EPISODIC | FACT
  kind    String
  content String

  /// 1-10. Drives retrieval ranking together with recency.
  importance Int @default(5)

  /// Where the memory came from: CONVERSATION | TASK | EVENT | TOOL |
  /// OBSERVATION | HUMAN | SYSTEM. Kept as provenance, not as a foreign key,
  /// so a memory survives the deletion of its trigger.
  source String @default("SYSTEM")

  // Optional links for cross-reference / timeline reconstruction.
  taskId         String?
  conversationId String?
  eventId        String?
  relatedAgentId String?

  /// JSON -- Phase 2: embedding vector handle, tags, salience decay curve.
  metadata String @default("{}")

  accessCount     Int       @default(0)
  lastAccessedAt  DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, kind])
  @@index([agentId, importance])
  @@index([taskId])
  @@index([expiresAt])
}

model AgentRelationship {
  id       String @id @default(cuid())
  agentId  String
  targetAgentId String

  /// Phase 2 social graph. Bounds: -100..100.
  affinity        Int @default(0)
  trust           Int @default(50)
  interactionCount Int @default(0)
  notes           String?
  lastInteractionAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent  Agent @relation("RelationshipSource", fields: [agentId], references: [id], onDelete: Cascade)
  target Agent @relation("RelationshipTarget", fields: [targetAgentId], references: [id], onDelete: Cascade)

  @@unique([agentId, targetAgentId])
  @@index([targetAgentId])
}

// =============================================================================
// TASKS
// =============================================================================

model Project {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  /// PLANNING | ACTIVE | PAUSED | COMPLETED | CANCELLED
  status      String   @default("PLANNING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks   Task[]
  workspaces Workspace[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  /// PENDING | PLANNED | ASSIGNED | RUNNING | WAITING_APPROVAL | BLOCKED |
  /// COMPLETED | FAILED | CANCELLED
  status      String  @default("PENDING")
  /// LOW | MEDIUM | HIGH | CRITICAL
  priority    String  @default("MEDIUM")

  companyId  String?
  projectId  String?
  parentTaskId String?
  /// Phase 2 -- set when the task was decomposed out of a Plan.
  planId     String?

  /// PLANNING | RESEARCH | ANALYSIS | IMPLEMENTATION | TESTING | REVIEW |
  /// OPERATIONS | COORDINATION | COMMUNICATION | GENERAL. Drives delegation
  /// matching: a task's type is matched against an agent's capabilities.
  type       String  @default("GENERAL")

  creatorAgentId String?
  creatorUserId  String?
  assigneeAgentId String?

  result String?
  error  String?
  /// JSON -- free-form execution context, plan steps, artifacts.
  metadata String @default("{}")

  /// Total attempts. Each execution attempt increments it.
  attempts Int @default(0)

  /// Phase 2 review/rework loop. A task is reworked at most maxRetries times
  /// after a NEEDS_CHANGES review; the counter is the number of reworks spent.
  reworkCount Int @default(0)
  maxRetries  Int @default(2)

  plannedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  plan      Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  parentTask Task?    @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks Task[]   @relation("TaskHierarchy")
  creatorAgent Agent? @relation("TaskCreatorAgent", fields: [creatorAgentId], references: [id], onDelete: SetNull)
  assigneeAgent Agent? @relation("TaskAssigneeAgent", fields: [assigneeAgentId], references: [id], onDelete: SetNull)

  blockedBy        TaskDependency[] @relation("TaskBlockedBy")
  blocks           TaskDependency[] @relation("TaskBlocks")
  messages         Message[]
  currentForStates AgentState[]     @relation("AgentStateCurrentTask")
  approvals        ApprovalRequest[]
  reviews          TaskReview[]
  reports          Report[]
  sessions         AgentSession[]
  escalations      Escalation[]
  conflicts        DecisionConflict[]
  artifacts        Artifact[]
  executions       ExecutionJob[]

  @@index([status])
  @@index([priority])
  @@index([assigneeAgentId, status])
  @@index([creatorAgentId])
  @@index([companyId])
  @@index([projectId])
  @@index([parentTaskId])
}

model TaskDependency {
  id             String @id @default(cuid())
  /// The task that cannot proceed yet.
  taskId         String
  /// The task that must complete first.
  dependsOnTaskId String
  createdAt      DateTime @default(now())

  task     Task @relation("TaskBlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskBlocks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

// =============================================================================
// ORCHESTRATION -- Phase 2: plans, sessions, reviews, reports, hierarchy
// =============================================================================

model Plan {
  id          String  @id @default(cuid())
  companyId   String?
  title       String
  objective   String
  description String?

  /// Who authored the plan. Plans are attributed, never anonymous.
  createdByAgentId String?
  createdByUserId  String?

  /// LOW | MEDIUM | HIGH | URGENT | CRITICAL
  priority String @default("MEDIUM")
  /// DRAFT | ANALYZING | READY | EXECUTING | PAUSED | COMPLETED | FAILED |
  /// CANCELLED
  status   String @default("DRAFT")

  /// JSON string[] -- ordered milestones.
  milestones  String @default("[]")
  /// JSON string[] -- what the plan takes for granted.
  assumptions String @default("[]")
  /// JSON string[] -- identified risks.
  risks       String @default("[]")
  /// JSON -- reasoning summary, recommendations, routing notes.
  metadata    String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy Agent?    @relation("PlanCreatorAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  author    User?     @relation("PlanCreatorUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  tasks    Task[]
  reports  Report[]
  conflicts DecisionConflict[]
  escalations Escalation[]

  @@index([status])
  @@index([companyId])
  @@index([createdByAgentId])
  @@index([priority])
}

/// One review pass over a task's result. Append-only: rework creates a new row.
model TaskReview {
  id      String @id @default(cuid())
  taskId  String
  /// 1-based execution attempt this review judged.
  attempt Int    @default(1)

  reviewerAgentId String?
  reviewerUserId  String?

  /// APPROVED | NEEDS_CHANGES | REJECTED | ESCALATE
  outcome String
  notes   String
  /// JSON -- per-criterion checks: [{ criterion, met, note }]
  criteria String @default("[]")

  createdAt DateTime @default(now())

  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer Agent? @relation("ReviewAuthorAgent", fields: [reviewerAgentId], references: [id], onDelete: SetNull)
  author   User?  @relation("ReviewAuthorUser", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([outcome])
  @@index([reviewerAgentId])
}

/// Structured output an agent produces for a human or another agent.
model Report {
  id   String @id @default(cuid())
  /// PROGRESS | TASK | EXECUTION | REVIEW | ERROR
  kind String

  authorAgentId String?
  authorUserId  String?

  taskId         String?
  planId         String?
  conversationId String?

  /// One-line summary. The detail lives in payload.
  summary String
  /// JSON -- { workCompleted, workRemaining, blockers, risks, filesChanged,
  ///           tests, recommendations }
  payload String @default("{}")

  createdAt DateTime @default(now())

  author  Agent? @relation("ReportAuthorAgent", fields: [authorAgentId], references: [id], onDelete: SetNull)
  byUser  User?  @relation("ReportAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  task    Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  plan    Plan?  @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([authorAgentId])
  @@index([taskId])
  @@index([planId])
  @@index([createdAt])
}

/// A bounded reasoning/execution run of an agent. Observability record -- the
/// King inspects this instead of the model's private context.
model AgentSession {
  id        String  @id @default(cuid())
  agentId   String
  /// Which provider/model this run actually used (after ModelRouter).
  providerId String
  model      String

  taskId String?

  /// Phase 3: where this run executes. Null = legacy non-workspace run.
  workspaceId String?
  /// Execution backend id: opencode | local | mock.
  backendId   String?

  /// INITIALIZING | QUEUED | RUNNING | WAITING | COMPLETED | FAILED |
  /// CANCELLED | TIMEOUT
  status String @default("INITIALIZING")

  /// JSON -- { trigger, taskType, planId, conversationId, capabilities }
  context   String  @default("{}")
  /// JSON -- [{ name, status, durationMs, approvalRequestId }]
  toolCalls String  @default("[]")
  result    String?
  error     String?

  correlationId String?

  startedAt DateTime @default(now())
  endedAt   DateTime?
  updatedAt DateTime @updatedAt

  agent     Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  artifacts  Artifact[]
  executions ExecutionJob[]

  @@index([agentId, status])
  @@index([status])
  @@index([taskId])
  @@index([workspaceId])
  @@index([startedAt])
}

/// Configurable reporting lines. The hierarchy is DATA: business logic reads
/// these rows and never branches on an agent's name.
model AgentHierarchy {
  id String @id @default(cuid())

  subordinateAgentId String
  supervisorAgentId  String

  /// STRATEGIC (reports plans) | OPERATIONAL (reports execution)
  kind String @default("OPERATIONAL")

  createdAt DateTime @default(now())

  subordinate Agent @relation("HierarchySubordinate", fields: [subordinateAgentId], references: [id], onDelete: Cascade)
  supervisor  Agent @relation("HierarchySupervisor", fields: [supervisorAgentId], references: [id], onDelete: Cascade)

  @@unique([subordinateAgentId, supervisorAgentId, kind])
  @@index([supervisorAgentId])
}

model Escalation {
  id      String @id @default(cuid())
  fromAgentId String
  /// Escalate to an agent (Rashid/Ahmad) or directly to the King.
  toAgentId   String?
  toUserId    String?
  taskId      String?
  planId      String?
  approvalRequestId String?

  /// BLOCKED | TOOL_UNAVAILABLE | TASK_IMPOSSIBLE | APPROVAL_REQUIRED |
  /// REPEATED_FAILURE | PERMISSION_DENIED | MISSING_INFORMATION
  category String
  detail   String

  /// OPEN | ACKNOWLEDGED | RESOLVED | REJECTED
  status String @default("OPEN")
  resolution String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  fromAgent Agent?  @relation("EscalationFromAgent", fields: [fromAgentId], references: [id], onDelete: Cascade)
  toAgent   Agent?  @relation("EscalationToAgent", fields: [toAgentId], references: [id], onDelete: SetNull)
  toUser    User?   @relation("EscalationToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  plan      Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  approval  ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([fromAgentId])
  @@index([toAgentId])
  @@index([category])
  @@index([createdAt])
}

/// A recorded disagreement between agents. Bounded: it either resolves or
/// escalates -- it can never loop.
model DecisionConflict {
  id String @id @default(cuid())

  /// What the participants disagree about.
  issue String
  /// JSON -- [{ agentId, position, evidence }]
  participants String @default("[]")
  /// JSON -- { positions: [...], proposedResolution }
  positions String @default("{}")
  evidence  String?

  /// OPEN | DISCUSSING | RESOLVED | ESCALATED
  status String @default("OPEN")
  resolution String?

  taskId String?
  planId String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([taskId])
  @@index([createdAt])
}

// =============================================================================
// COMMUNICATION
// =============================================================================

model Conversation {
  id       String  @id @default(cuid())
  /// HUMAN_AGENT | AGENT_AGENT | SYSTEM
  kind     String
  title    String
  companyId String?
  createdByUserId String?
  isClosed Boolean  @default(false)
  /// JSON -- Phase 2: shared context window, topic, priority.
  metadata  String  @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([companyId])
  @@index([kind])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  agentId        String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([conversationId, agentId])
  @@index([agentId])
}

model Message {
  id             String  @id @default(cuid())
  conversationId String

  /// HUMAN | AGENT | SYSTEM
  senderType String
  senderUserId  String?
  senderAgentId String?

  /// MESSAGE | PLAN | REPORT | REQUEST | QUESTION | APPROVAL_REQUEST |
  /// TOOL_RESULT | TASK_RESULT | SYSTEM_NOTICE
  kind    String @default("MESSAGE")

  content String
  taskId  String?
  /// Correlates with the correlationId that produced this message.
  correlationId String?
  /// JSON -- plan payload, tool invocations, approval snapshot.
  metadata String @default("{}")

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation("MessageSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderAgent  Agent?       @relation("MessageSenderAgent", fields: [senderAgentId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderAgentId])
  @@index([taskId])
}

// =============================================================================
// ECONOMY -- append-only double-entry ledger
// =============================================================================

model Wallet {
  id     String @id @default(cuid())
  /// AGENT | USER | COMPANY
  ownerType String
  ownerId   String
  currency  String @default("KW")

  /// Signed balance in MINOR UNITS. Only packages/economy LedgerService may
  /// write this column, and only inside a DB transaction that also appends
  /// Transaction rows. There is no other code path in the system.
  balanceMinor Int @default(0)

  /// Optimistic-lock counter. Every balance write bumps it and asserts the
  /// previous value, which makes concurrent double-spend structurally
  /// impossible rather than merely unlikely.
  version   Int      @default(0)
  isFrozen  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner            User?          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerUserId      String?
  transactions     Transaction[]
  outgoingTransfers Transaction[] @relation("TransferCounterparty")

  @@unique([ownerType, ownerId, currency])
  @@index([ownerType, ownerId])
}

model Transaction {
  id       String @id @default(cuid())
  walletId String

  /// DEPOSIT | WITHDRAWAL | TRANSFER | SALARY | PURCHASE | REWARD |
  /// PENALTY | TAX | FEE | ADJUSTMENT
  type String

  /// DEBIT | CREDIT -- the effect of this leg on `walletId`.
  direction String

  /// Always positive. Sign is carried by `direction`.
  amountMinor Int

  /// Wallet balance immediately after this leg was applied. Makes the
  /// statement independently verifiable without replaying the whole ledger.
  balanceAfterMinor Int

  currency String @default("KW")

  /// Two legs of a transfer share one group id.
  transferGroupId String?

  counterpartyType String?
  counterpartyId   String?

  referenceType String?
  referenceId   String?

  description String?

  /// USER | AGENT | SYSTEM
  actorType String
  actorId   String?
  approvalRequestId String?

  /// Client-supplied dedupe key. Unique -- retrying a payment can never
  /// double-charge.
  idempotencyKey String?

  /// JSON
  metadata String @default("{}")
  createdAt DateTime @default(now())

  wallet         Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  counterparty   Wallet? @relation("TransferCounterparty", fields: [counterpartyWalletId], references: [id], onDelete: SetNull)
  counterpartyWalletId String?
  approval       ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@unique([walletId, idempotencyKey])
  @@index([walletId, createdAt])
  @@index([transferGroupId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([approvalRequestId])
}

// =============================================================================
// APPROVALS
// =============================================================================

model ApprovalRequest {
  id String @id @default(cuid())

  /// USER | AGENT | SYSTEM
  requesterType String
  requesterAgentId String?
  requesterUserId  String?

  /// Dotted action identifier, e.g. "wallet.transfer" or "agent.create".
  action         String
  /// JSON -- the exact arguments that were withheld pending approval.
  actionPayload  String
  reason         String

  /// LOW | MEDIUM | HIGH | CRITICAL
  risk String @default("MEDIUM")

  /// PENDING | APPROVED | REJECTED | EXPIRED
  status String @default("PENDING")

  companyId String?
  worldId   String?
  taskId    String?

  decidedByUserId String?
  decisionNote    String?
  decidedAt       DateTime?

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  requester  Agent?    @relation("ApprovalRequestAgentRequester", fields: [requesterAgentId], references: [id], onDelete: SetNull)
  requesterUser User?   @relation("ApprovalRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  decidedBy  User?     @relation("ApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  world      World?    @relation(fields: [worldId], references: [id], onDelete: SetNull)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  escalations  Escalation[]
  // After approval the request re-drives the original tool invocation exactly
  // once. Guarded by these two columns.
  executedAt  DateTime?
  executionError String?

  @@index([status])
  @@index([requesterAgentId])
  @@index([companyId])
  @@index([expiresAt])
}

// =============================================================================
// AGENT FACTORY (Phase 1 = blueprint + approval only, no instantiation)
// =============================================================================

model AgentBlueprint {
  id       String @id @default(cuid())
  companyId String?

  name     String
  roleKey  String
  title    String

  systemPrompt String
  personality  String @default("{}")
  goals        String @default("[]")
  skills       String @default("[]")
  capabilities String @default("[]")

  providerId  String
  model       String
  temperature Float @default(0.3)
  maxTokens   Int    @default(2048)

  /// DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | INSTANTIATED
  status String @default("DRAFT")

  requestedByAgentId String?
  approvalRequestId  String?
  instantiatedAgentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedBy Agent? @relation("BlueprintRequester", fields: [requestedByAgentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
}

// =============================================================================
// OBSERVABILITY
// =============================================================================

model EventLog {
  /// Monotonic integer id -- the event log's primary ordering key.
  id Int @id @default(autoincrement())

  type String
  /// INFO | WARN | ERROR | CRITICAL
  severity String @default("INFO")

  /// USER | AGENT | SYSTEM
  actorType String
  actorId   String?
  actorName String?

  targetType String?
  targetId   String?

  worldId String?
  cityId  String?
  companyId String?

  /// JSON
  payload String @default("{}")

  correlationId String
  createdAt DateTime @default(now())

  @@index([correlationId])
  @@index([type])
  @@index([createdAt])
  @@index([actorType, actorId])
  @@index([worldId])
  @@index([companyId])
}

model ActivityLog {
  id Int @id @default(autoincrement())

  /// USER | AGENT | SYSTEM
  actorType String
  actorId   String?
  actorName String

  action     String
  targetType String?
  targetId   String?
  /// OK | ERROR
  result String @default("OK")
  error  String?

  correlationId String
  ip            String?
  userAgent     String?
  /// JSON
  metadata      String @default("{}")
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId String?

  @@index([correlationId])
  @@index([actorType, actorId])
  @@index([action])
  @@index([createdAt])
}

model ToolInvocation {
  id Int @id @default(autoincrement())

  agentId String?
  toolName String
  /// JSON -- validated arguments
  arguments String
  /// SUCCESS | DENIED | PENDING_APPROVAL | ERROR
  status String
  /// JSON
  result  String?
  error   String?
  durationMs Int?

  correlationId String
  approvalRequestId String?
  createdAt DateTime @default(now())

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([toolName])
  @@index([correlationId])
  @@index([createdAt])
}

// =============================================================================
// WORKSPACES -- Phase 3: real work environments, independent of simulation
// =============================================================================

/// An agent's actual work environment. Independent from personality and
/// simulation state: one primary workspace per agent, plus project and
/// temporary execution workspaces. The simulation may know an agent is
/// WORKING; the work itself happens here.
model Workspace {
  id   String @id @default(cuid())
  name String

  /// Primary holder. Null = shared/team workspace governed by members.
  agentId   String?
  projectId String?

  /// PERSONAL | PROJECT | TEMPORARY | SHARED
  type String @default("PERSONAL")
  /// Absolute path, always under an approved root (enforced server-side).
  path String @unique

  /// CREATING | READY | BUSY | PAUSED | ERROR | ARCHIVED
  status String @default("CREATING")

  /// JSON -- { runtime, packageManager, commands, limits, ttlHours? }.
  /// Never stores secrets; references only.
  environment String @default("{}")

  /// 3D mapping hook: the renderer consumes it, never the other way round.
  workspaceLocationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent   Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members WorkspaceMember[]

  sessions   AgentSession[]
  artifacts  Artifact[]
  executions ExecutionJob[]

  @@index([agentId])
  @@index([projectId])
  @@index([status])
  @@index([type])
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String
  agentId     String

  /// OWNER | MEMBER | READER
  role String @default("MEMBER")

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, agentId])
  @@index([agentId])
}

// =============================================================================
// EXECUTION -- Phase 3: queued work, real processes, produced files
// =============================================================================

/// One unit of queued or running execution work (M5 queue + M3 backends).
/// `command` is a JSON argv array -- never a shell string; the runtime spawns
/// with shell:false and the policy layer decides what may run at all.
model ExecutionJob {
  id String @id @default(cuid())

  /// COMMAND | VERIFY | BACKEND
  kind String @default("COMMAND")
  /// QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED | TIMEOUT
  status String @default("QUEUED")

  /// Backend that will run it: opencode | local | mock.
  backendId String?
  /// JSON argv array. Security-critical: never a concatenated shell line.
  command   String?
  /// Absolute working directory; validated inside the workspace root server-side.
  workingDir String?

  workspaceId String?
  sessionId   String?
  taskId      String?
  agentId     String?

  priority    Int @default(0)
  attempts    Int @default(0)
  maxAttempts Int @default(1)
  timeoutMs   Int @default(600000)

  scheduledAt DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  exitCode    Int?
  stdoutBytes Int @default(0)
  stderrBytes Int @default(0)

  /// JSON -- { exitCode, stdoutPath, stderrPath, durationMs, timedOut }.
  /// Paths only; output is spooled to files under the workspace, not into rows.
  result String?
  error  String?
  /// ErrorCategory value (TRANSIENT | CONFIGURATION | ... | UNKNOWN).
  errorCategory String?

  createdBy     String?
  correlationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  session   AgentSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agent     Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)

  artifacts Artifact[]

  @@index([status, scheduledAt])
  @@index([workspaceId])
  @@index([sessionId])
  @@index([agentId])
  @@index([taskId])
  @@index([correlationId])
}

/// A file, log, report or other product registered for the dashboard.
/// `path` is relative to the workspace root; the path guard re-validates it
/// on read. Rows may outlive files (status MISSING), files never outlive rows.
model Artifact {
  id   String @id @default(cuid())
  name String

  /// FILE | LOG | REPORT | DIFF | OUTPUT
  kind String @default("FILE")
  /// Relative to the workspace root (never an absolute path outside it).
  path       String
  sizeBytes  Int    @default(0)
  contentHash String?
  mimeType   String?

  /// PENDING | READY | MISSING | ARCHIVED
  status String @default("READY")

  workspaceId String?
  sessionId   String?
  taskId      String?
  agentId     String?
  executionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  session   AgentSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agent     Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  execution ExecutionJob?  @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([sessionId])
  @@index([taskId])
  @@index([agentId])
  @@index([executionId])
  @@index([kind])
}