# ─────────────────────────────────────────────────────────────
# AgentWorld — environment template.  Copy to `.env` and fill in.
#   cp .env.example .env
# NEVER commit a filled-in `.env`. It is git-ignored.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────
# Phase 1 uses SQLite (zero infra). To move to Postgres change the
# datasource in database/schema.prisma and point this at the server.
DATABASE_URL="file:./kingworld.db"

# ── Security ────────────────────────────────────────────────
# REQUIRED in production. Generate: openssl rand -hex 48
# In development a stable dev-only fallback is used and a warning is logged.
JWT_SECRET="dev-only-insecure-secret-change-me"
JWT_EXPIRES_IN="12h"
# bcrypt cost factor (10-12 recommended)
BCRYPT_ROUNDS=12

# Reverse proxies in front of the API (hop count). Needed so per-IP rate limits see
# real client IPs; keep it EXACT (too high lets clients spoof X-Forwarded-For).
TRUST_PROXY=0
# Serve the built dashboard (apps/web/dist) from the API itself, same origin: one process, one port.
# Build it first with `npm run build:web` (set VITE_API_BASE_URL=/api/v1 when building for this mode).
SERVE_WEB=false
# WEB_DIST_DIR="apps/web/dist"
# Comma-separated exact origins allowed to call the API. No wildcards.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# REQUIRED in production before any credential is stored (the vault refuses without it).
# Base64 of 32 random bytes. Generate: openssl rand -base64 32
# Development derives a stable key so a fresh clone still runs.
VAULT_MASTER_KEY=

# ── Seed owner account (development only) ───────────────────
SEED_OWNER_EMAIL="king@kingworld.local"
SEED_OWNER_PASSWORD="KingWorld!2026"

# ── AI providers ────────────────────────────────────────────
# Agents select a provider by id via the AIProvider abstraction.
# `mock` is deterministic and offline — always available, zero cost.
# It lets the full agent loop run end-to-end with no keys configured.
DEFAULT_PROVIDER=mock

# OpenAI-compatible (OpenAI, Groq, OpenRouter, Together, LM Studio,
# Ollama via its /v1 shim — anything speaking /v1/chat/completions)
OPENAI_COMPATIBLE_ENABLED=false
OPENAI_COMPATIBLE_BASE_URL="https://api.openai.com/v1"
OPENAI_COMPATIBLE_API_KEY=""

# Anthropic-compatible (Anthropic, or compatible gateways)
ANTHROPIC_ENABLED=false
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
ANTHROPIC_API_KEY=""
ANTHROPIC_VERSION="2023-06-01"

# Google-compatible (Google Gemini via generativelanguage endpoint)
GOOGLE_ENABLED=false
GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GOOGLE_API_KEY=""

# ── Agent defaults ──────────────────────────────────────────
AGENT_MAX_TOOL_ITERATIONS=8
AGENT_REQUEST_TIMEOUT_MS=120000

# ── Approval policy ─────────────────────────────────────────
# Virtual-currency spend above this (major units) requires human approval.
APPROVAL_SPEND_THRESHOLD=1000
APPROVAL_ENABLED=true
# Four-eyes rule: a human may not decide an approval request they raised.
APPROVAL_FOUR_EYES=false

# ── AI budget ───────────────────────────────────────────────
# Refuse paid AI calls for a company whose treasury balance is below this many
# minor units (the free mock provider still answers). 0 = off.
AI_MIN_TREASURY_MINOR=0

# ── Simulation ──────────────────────────────────────────────
# 1 real second = N simulated seconds. Drives world.time_offset_minutes.
WORLD_TIME_SCALE=60
# Real milliseconds between simulation ticks (heartbeat). Default 5000.
# SIMULATION_TICK_MS=5000

# ── Execution runtime ───────────────────────────────────────
# Backend for ExecutionJobs that don't pin one: local | mock | opencode.
EXECUTION_BACKEND=local
# Executable for the opencode backend (the only place it is named,
# besides packages/execution/src/backends/opencode.ts).
OPENCODE_COMMAND=opencode

# ── Command execution ───────────────────────────────────────
# local  = agent commands run on the host (command policy only; dev/test).
# docker = one throwaway container per command: no network, read-only root,
#          dropped capabilities, non-root, resource limits, only the workspace
#          mounted. The server refuses to start if Docker or the image is
#          missing (build: docker build -t kingworld-sandbox:1 docker/sandbox).
# Default: docker when NODE_ENV=production, local otherwise. local in production
# REFUSES TO BOOT unless EXEC_ALLOW_UNSANDBOXED_PRODUCTION=true (explicit risk
# acceptance; never with untrusted agents or real AI providers).
# EXEC_SANDBOX=docker
# EXEC_ALLOW_UNSANDBOXED_PRODUCTION=false
# Max agent child processes alive at once per API process (1-256).
# EXEC_MAX_CONCURRENT=16
EXEC_DOCKER_IMAGE=kingworld-sandbox:1
# uid:gid for the container. Empty = owner of the workspace dir (never root).
EXEC_DOCKER_USER=
EXEC_DOCKER_MEMORY=512m
EXEC_DOCKER_CPUS=1
EXEC_DOCKER_PIDS=256

# ── More AI providers ───────────────────────────────────────
# Any OpenAI-compatible endpoint under your own provider id.
CUSTOM_PROVIDER_ENABLED=false
CUSTOM_PROVIDER_ID=""
CUSTOM_PROVIDER_BASE_URL=""
CUSTOM_PROVIDER_API_KEY=""
CUSTOM_PROVIDER_MODEL=""
# Ollama-style local server (no key needed).
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL="http://127.0.0.1:11434/v1"
LOCAL_AI_API_KEY=""
LOCAL_AI_MODEL="llama3.1"

# ── Software Factory (GitHub) ───────────────────────────────
# Token with repo scope for analysis, branches and pull requests.
# Without it, GitHub stages stop with an explicit BLOCKED/ERROR record.
FACTORY_GITHUB_TOKEN=""
FACTORY_GITHUB_API_BASE="https://api.github.com"
FACTORY_MAX_FIX_ATTEMPTS=3

# ── Production checklist ────────────────────────────────────
# NODE_ENV=production
# JWT_SECRET=<openssl rand -hex 48>          (the default is refused)
# SEED_OWNER_PASSWORD=<your own>             (the default is refused)
# VAULT_MASTER_KEY=<openssl rand -base64 32>
# DATABASE_URL="file:/absolute/path/agentworld.db"
# CORS_ORIGINS=<your dashboard origin>
# TRUST_PROXY=<exact proxy hop count>
# EXEC_SANDBOX=docker                        (needs Docker and the sandbox image)
#   or EXEC_SANDBOX=local with EXEC_ALLOW_UNSANDBOXED_PRODUCTION=true  (accepts the risk explicitly)
